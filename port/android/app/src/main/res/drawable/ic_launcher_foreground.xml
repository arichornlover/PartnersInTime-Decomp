<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon foreground: the clock ring and cobalt star, kept inside the
  66dp safe zone of the 108dp canvas so no launcher mask clips it. The matching
  raster badge (background plus art) is generated by tools/gen_icon.ps1.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Clock ring. -->
    <path
        android:strokeColor="#F2B233"
        android:strokeWidth="4"
        android:fillColor="#00000000"
        android:pathData="M24,54 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />

    <!-- Tick marks. -->
    <path
        android:strokeColor="#FFD766"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,32 L54,24 M54,76 L54,84 M32,54 L24,54 M76,54 L84,54" />

    <!-- Four-point cobalt star. -->
    <path
        android:fillColor="#3D7BE8"
        android:strokeColor="#F2B233"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M54,30 L59.657,48.343 L78,54 L59.657,59.657 L54,78 L48.343,59.657 L30,54 L48.343,48.343 Z" />

    <!-- Golden core. -->
    <path
        android:fillColor="#FFD766"
        android:pathData="M49,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
